{
  "name": "zeb/prosemirror",
  "version": "0.1",
  "kind": "web-library",
  "trust": "official",
  "description": "ProseMirror editing engine (view 1.42, model 1.25) under zeb/ui/editor: Zebflow's block schema, createEditor with callbacks and no UI of its own, the ProseMirror packages as `pm` for custom editors.",
  "source": {
    "provider": "zebflow",
    "package": "prosemirror-view",
    "package_version": "1.42.3",
    "packed_version": "full-1.42",
    "packed_kind": "full",
    "entry": "runtime/prosemirror.bundle.mjs"
  },
  "registry": {
    "kind": "github-releases",
    "repo": "zebflow/libraries",
    "asset_pattern": "zeb-prosemirror-{version}.bundle.mjs"
  },
  "exports": {
    "raw": [
      "pm",
      "createSchema",
      "createEditor",
      "htmlToDocument",
      "EMPTY_DOC"
    ],
    "wrappers": []
  },
  "runtime": {
    "format": "esm",
    "entry": "runtime/prosemirror.bundle.mjs"
  },
  "editor": {
    "keywords": "keywords.json",
    "exports": "exports.json"
  }
}
