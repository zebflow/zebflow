{
  "apiVersion": "zebflow.com/v1",
  "kind": "NodeBundle",
  "metadata": {
    "name": "openai-embedding",
    "version": "1.0.0"
  },
  "spec": {
    "package": "openai-embedding",
    "version": "1.0.0",
    "title": "OpenAI Embedding",
    "description": "Generate text embeddings using any OpenAI-compatible API (/v1/embeddings).",
    "icon": "icon.svg",
    "credentials": [
      {
        "kind": "openai",
        "title": "OpenAI",
        "description": "OpenAI provider credential.",
        "fields": [],
        "placeholders": {
          "API_KEY": "api_key",
          "BASE_URL": "base_url",
          "MODEL": "model",
          "EMBEDDING_PATH": "embedding_path"
        },
        "config_key": "credential_id"
      },
      {
        "kind": "openrouter",
        "title": "OpenRouter",
        "description": "OpenRouter provider credential.",
        "fields": [],
        "placeholders": {
          "API_KEY": "api_key",
          "BASE_URL": "base_url",
          "MODEL": "model",
          "EMBEDDING_PATH": "embedding_path"
        },
        "config_key": "credential_id"
      }
    ],
    "hosts": [
      "api.openai.com",
      "openrouter.ai"
    ],
    "functions": {
      "embed": "functions/embed.zf.json"
    },
    "modules": {},
    "nodes": [
      {
        "kind": "ai.embedding.generate",
        "title": "AI Embedding",
        "description": "Embeds text through an OpenAI-compatible /v1/embeddings endpoint (OpenAI, OpenRouter, or the credential's base URL). Answers `embedding: { vectors, model, dims, usage }` — one vector per `--text`, in order — and keeps the payload; a provider refusal delivers `error`.",
        "icon": "icons/embedding.svg",
        "ui_category": "logic.ai",
        "ui_category_label": "AI",
        "uses_credentials": [
          "openai",
          "openrouter"
        ],
        "run": {
          "function": "embed"
        },
        "definition": {
          "input_pins": [
            "in"
          ],
          "output_pins": [
            "out",
            "error"
          ],
          "config_schema": {
            "type": "object",
            "properties": {
              "credential_id": {
                "type": "string"
              },
              "model": {
                "type": "string"
              },
              "text": {
                "type": [
                  "array",
                  "string"
                ]
              }
            }
          },
          "dsl_flags": [
            {
              "flag": "--credential",
              "config_key": "credential_id",
              "kind": "scalar",
              "required": true,
              "value": "text",
              "description": "The openai or openrouter credential."
            },
            {
              "flag": "--model",
              "config_key": "model",
              "kind": "scalar",
              "required": false,
              "value": "text",
              "description": "The embedding model, e.g. text-embedding-3-small. Omitted: the credential's model, else text-embedding-3-small."
            },
            {
              "flag": "--text",
              "config_key": "text",
              "kind": "repeated_list",
              "required": true,
              "value": "text",
              "max_repeat": 2048,
              "description": "A text to embed — repeat for several, or one {{ [list] }}; each gets its own vector."
            }
          ],
          "fields": [
            {
              "name": "credential_id",
              "label": "Credential",
              "type": "select",
              "data_source": "credentials_open_ai",
              "help": "An OpenAI or OpenRouter credential."
            },
            {
              "name": "model",
              "label": "Model",
              "type": "text",
              "help": "Embedding model id. Empty: the credential's model, else text-embedding-3-small."
            },
            {
              "name": "text",
              "label": "Text",
              "type": "textarea",
              "rows": 3,
              "help": "The text to embed: a literal or {{ expr }}, or {{ [list] }} for several."
            }
          ],
          "layout": [
            "credential_id",
            "model",
            "text"
          ],
          "output_schema": {
            "type": "object",
            "properties": {
              "embedding": {
                "type": "object",
                "properties": {
                  "vectors": {
                    "type": "array",
                    "description": "One vector per text, in the order given."
                  },
                  "model": {
                    "type": "string"
                  },
                  "dims": {
                    "type": "integer",
                    "description": "The length of each vector."
                  },
                  "usage": {
                    "type": [
                      "object",
                      "null"
                    ],
                    "description": "Token usage as the provider reported it."
                  }
                }
              }
            }
          }
        }
      }
    ]
  }
}
