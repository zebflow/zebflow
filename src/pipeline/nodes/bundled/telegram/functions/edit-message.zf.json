{
  "apiVersion": "zebflow.com/v1",
  "kind": "Pipeline",
  "metadata": {
    "name": "tg-edit-message"
  },
  "spec": {
    "id": "tg-edit-message",
    "nodes": [
      {
        "id": "trigger",
        "kind": "n.trigger.function",
        "config": {},
        "input_pins": [],
        "output_pins": [
          "out"
        ]
      },
      {
        "id": "prepare",
        "kind": "n.script",
        "config": {
          "source": "var body = { chat_id: String(input.chat_id), message_id: Number(input.message_id), text: String(input.text) }; if (input.parse_mode) body.parse_mode = String(input.parse_mode); return body;"
        },
        "input_pins": [
          "in"
        ],
        "output_pins": [
          "out"
        ]
      },
      {
        "id": "send",
        "kind": "n.http.request",
        "config": {
          "method": "POST",
          "url": "https://api.telegram.org/bot{{ $placeholder.BOT_TOKEN }}/editMessageText",
          "headers": {
            "Content-Type": "application/json"
          },
          "body_path": "",
          "response_type": "json"
        },
        "input_pins": [
          "in"
        ],
        "output_pins": [
          "out"
        ]
      }
    ],
    "edges": [
      {
        "from_node": "trigger",
        "from_pin": "out",
        "to_node": "prepare",
        "to_pin": "in"
      },
      {
        "from_node": "prepare",
        "from_pin": "out",
        "to_node": "send",
        "to_pin": "in"
      }
    ]
  }
}
