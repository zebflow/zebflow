{
  "apiVersion": "zebflow.com/v1",
  "kind": "Pipeline",
  "metadata": {
    "name": "tg-delete-webhook"
  },
  "spec": {
    "id": "tg-delete-webhook",
    "nodes": [
      {
        "id": "trigger",
        "kind": "n.trigger.function",
        "config": {},
        "input_pins": [],
        "output_pins": [
          "out"
        ]
      },
      {
        "id": "delete",
        "kind": "n.http.request",
        "config": {
          "method": "POST",
          "url": "https://api.telegram.org/bot{{ $placeholder.BOT_TOKEN }}/deleteWebhook",
          "headers": {
            "Content-Type": "application/json"
          },
          "body": "{}",
          "response_type": "json"
        },
        "input_pins": [
          "in"
        ],
        "output_pins": [
          "out"
        ]
      },
      {
        "id": "clear",
        "kind": "n.kv.del",
        "config": {
          "key": "webhook_registered"
        },
        "input_pins": [
          "in"
        ],
        "output_pins": [
          "out"
        ]
      }
    ],
    "edges": [
      {
        "from_node": "trigger",
        "from_pin": "out",
        "to_node": "delete",
        "to_pin": "in"
      },
      {
        "from_node": "delete",
        "from_pin": "out",
        "to_node": "clear",
        "to_pin": "in"
      }
    ]
  }
}
