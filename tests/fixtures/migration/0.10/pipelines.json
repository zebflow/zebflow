  {
    "file_rel_path": "api/total.zf.json",
    "source": {
      "apiVersion": "zebflow.com/v1",
      "kind": "Pipeline",
      "metadata": {
        "name": "total"
      },
      "spec": {
        "id": "total",
        "entry_nodes": [
          "hook"
        ],
        "nodes": [
          {
            "id": "hook",
            "kind": "n.trigger.webhook",
            "input_pins": [],
            "output_pins": [
              "out"
            ],
            "config": {
              "path": "/total",
              "method": "POST",
              "ui": {
                "x": 120,
                "y": 120
              }
            }
          },
          {
            "id": "each",
            "kind": "n.logic.foreach",
            "input_pins": [
              "in"
            ],
            "output_pins": [
              "item"
            ],
            "config": {
              "items_expr": "input.body.nums",
              "ui": {
                "x": 480,
                "y": 120
              }
            }
          },
          {
            "id": "sum",
            "kind": "n.logic.reduce",
            "input_pins": [
              "in"
            ],
            "output_pins": [
              "out"
            ],
            "config": {
              "init_expr": "Number(0)",
              "step_expr": "$acc + $input.item",
              "ui": {
                "x": 840,
                "y": 120
              }
            }
          },
          {
            "id": "wrap",
            "kind": "n.script",
            "input_pins": [
              "in"
            ],
            "output_pins": [
              "out"
            ],
            "config": {
              "source": "return { total: input };",
              "ui": {
                "x": 1200,
                "y": 120
              }
            }
          }
        ],
        "edges": [
          {
            "from_node": "hook",
            "from_pin": "out",
            "to_node": "each",
            "to_pin": "in"
          },
          {
            "from_node": "each",
            "from_pin": "item",
            "to_node": "sum",
            "to_pin": "in"
          },
          {
            "from_node": "sum",
            "from_pin": "out",
            "to_node": "wrap",
            "to_pin": "in"
          }
        ]
      }
    }
  },
