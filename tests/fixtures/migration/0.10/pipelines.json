    "file_rel_path": "api/hello.zf.json",
    "source": {
      "apiVersion": "zebflow.com/v1",
      "kind": "Pipeline",
      "metadata": {
        "name": "hello"
      },
      "spec": {
        "id": "hello",
        "entry_nodes": [
          "n0"
        ],
        "nodes": [
          {
            "id": "n0",
            "kind": "n.trigger.webhook",
            "input_pins": [],
            "output_pins": [
              "out"
            ],
            "config": {
              "path": "/hello",
              "method": "GET",
              "ui": {
                "x": 120,
                "y": 120
              }
            }
          },
          {
            "id": "n1",
            "kind": "n.script",
            "input_pins": [
              "in"
            ],
            "output_pins": [
              "out"
            ],
            "config": {
              "source": "return { greeting: 'Hello ' + (input.query.name || 'world'), method: input.method };",
              "ui": {
                "x": 480,
                "y": 120
              }
            }
          }
        ],
        "edges": [
          {
            "from_node": "n0",
            "from_pin": "out",
            "to_node": "n1",
            "to_pin": "in"
          }
        ]
      }
    }
  },
