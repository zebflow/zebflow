  {
    "file_rel_path": "api/login.zf.json",
    "source": {
      "apiVersion": "zebflow.com/v1",
      "kind": "Pipeline",
      "metadata": {
        "name": "login"
      },
      "spec": {
        "id": "login",
        "entry_nodes": [
          "hook"
        ],
        "nodes": [
          {
            "id": "hook",
            "kind": "n.trigger.webhook",
            "input_pins": [],
            "output_pins": [
              "out"
            ],
            "config": {
              "path": "/login",
              "method": "POST",
              "ui": {
                "x": 120,
                "y": 120
              }
            }
          },
          {
            "id": "gate",
            "kind": "n.logic.if",
            "input_pins": [
              "in"
            ],
            "output_pins": [
              "true",
              "false"
            ],
            "config": {
              "expression": "input.body.user === 'demo'",
              "ui": {
                "x": 480,
                "y": 120
              }
            }
          },
          {
            "id": "home",
            "kind": "n.web.response",
            "input_pins": [
              "in"
            ],
            "output_pins": [
              "out"
            ],
            "config": {
              "location": "/home",
              "set_cookie": "name=session,value={{ input.body.user }},max-age=60",
              "ui": {
                "x": 840,
                "y": 120
              }
            }
          },
          {
            "id": "deny",
            "kind": "n.web.response",
            "input_pins": [
              "in"
            ],
            "output_pins": [
              "out"
            ],
            "config": {
              "status": 401,
              "message": "no entry",
              "ui": {
                "x": 840,
                "y": 300
              }
            }
          }
        ],
        "edges": [
          {
            "from_node": "hook",
            "from_pin": "out",
            "to_node": "gate",
            "to_pin": "in"
          },
          {
            "from_node": "gate",
            "from_pin": "true",
            "to_node": "home",
            "to_pin": "in"
          },
          {
            "from_node": "gate",
            "from_pin": "false",
            "to_node": "deny",
            "to_pin": "in"
          }
        ]
      }
    }
  },
  {
    "file_rel_path": "api/digest.zf.json",
    "source": {
      "apiVersion": "zebflow.com/v1",
      "kind": "Pipeline",
      "metadata": {
        "name": "digest"
      },
      "spec": {
        "id": "digest",
        "entry_nodes": [
          "n0"
        ],
        "nodes": [
          {
            "id": "n0",
            "kind": "n.trigger.webhook",
            "input_pins": [],
            "output_pins": [
              "out"
            ],
            "config": {
              "path": "/digest",
              "method": "POST",
              "ui": {
                "x": 120,
                "y": 120
              }
            }
          },
          {
            "id": "n1",
            "kind": "n.crypto",
            "input_pins": [
              "in"
            ],
            "output_pins": [
              "out",
              "true",
              "false"
            ],
            "config": {
              "op": "sha256",
              "input": "{{ input.body.text }}",
              "ui": {
                "x": 480,
                "y": 120
              }
            }
          },
          {
            "id": "n2",
            "kind": "n.crypto",
            "input_pins": [
              "in"
            ],
            "output_pins": [
              "out",
              "true",
              "false"
            ],
            "config": {
              "op": "base64_encode",
              "input": "{{ input.result }}",
              "ui": {
                "x": 840,
                "y": 120
              }
            }
          },
          {
            "id": "n3",
            "kind": "n.web.response",
            "input_pins": [
              "in"
            ],
            "output_pins": [
              "out"
            ],
            "config": {
              "body": "{{ { b64: input.result, text: input.body.text } }}",
              "ui": {
                "x": 1200,
                "y": 120
              }
            }
          }
        ],
        "edges": [
          {
            "from_node": "n0",
            "from_pin": "out",
            "to_node": "n1",
            "to_pin": "in"
          },
          {
            "from_node": "n1",
            "from_pin": "out",
            "to_node": "n2",
            "to_pin": "in"
          },
          {
            "from_node": "n2",
            "from_pin": "out",
            "to_node": "n3",
            "to_pin": "in"
          }
        ]
      }
    }
  },
  {
    "file_rel_path": "api/count.zf.json",
    "source": {
      "apiVersion": "zebflow.com/v1",
      "kind": "Pipeline",
      "metadata": {
        "name": "count"
      },
      "spec": {
        "id": "count",
        "entry_nodes": [
          "n0"
        ],
        "nodes": [
          {
            "id": "n0",
            "kind": "n.trigger.webhook",
            "input_pins": [],
            "output_pins": [
              "out"
            ],
            "config": {
              "path": "/count",
              "method": "POST",
              "ui": {
                "x": 120,
                "y": 120
              }
            }
          },
          {
            "id": "n1",
            "kind": "n.kv.set",
            "input_pins": [
              "in"
            ],
            "output_pins": [
              "out"
            ],
            "config": {
              "key": "counter:{{ input.body.k }}",
              "value": "{{ input.body.v }}",
              "ui": {
                "x": 480,
                "y": 120
              }
            }
          },
          {
            "id": "n2",
            "kind": "n.kv.get",
            "input_pins": [
              "in"
            ],
            "output_pins": [
              "out"
            ],
            "config": {
              "key": "counter:{{ input.body.k }}",
              "out_key": "stored",
              "ui": {
                "x": 840,
                "y": 120
              }
            }
          },
          {
            "id": "n3",
            "kind": "n.web.response",
            "input_pins": [
              "in"
            ],
            "output_pins": [
              "out"
            ],
            "config": {
              "body": "{{ { stored: input.stored, k: input.body.k } }}",
              "ui": {
                "x": 1200,
                "y": 120
              }
            }
          }
        ],
        "edges": [
          {
            "from_node": "n0",
            "from_pin": "out",
            "to_node": "n1",
            "to_pin": "in"
          },
          {
            "from_node": "n1",
            "from_pin": "out",
            "to_node": "n2",
            "to_pin": "in"
          },
          {
            "from_node": "n2",
            "from_pin": "out",
            "to_node": "n3",
            "to_pin": "in"
          }
        ]
      }
    }
  },
